<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Lecture seule : les widgets agenda consultent, ils ne modifient rien. -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <!-- Temps d'écran et données mobiles : accès accordé dans les réglages. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Temps d'écran : le nom et l'icône des applis utilisées (Android 11+
         cache sinon les autres applis). Appli personnelle, hors Play Store. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Écouteurs et montre : appareils Bluetooth connectés (Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Appareil : redessiné après un redémarrage. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Chronomètre et minuteur : sonner à la fin du minuteur. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Certaines applications Horloge l'exigent pour s'ouvrir depuis le widget. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Widget système : savoir si l'on est en ligne, et par quoi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Météo : prévisions Open-Meteo, et position approximative pour le lieu. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Système avancé : Wi-Fi activé ou non, bande et débit. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Système avancé : Bluetooth activé ou non (sans autorisation dès Android 12). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <application
        android:label="Halo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Raccourcis de l'icône (appui long). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Paramètres d'un widget, depuis un appui long sur l'écran d'accueil. -->
        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Widgets d'écran d'accueil : un <receiver> par widget. -->
        <receiver
            android:name=".widgets.ClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Redessine la prochaine alarme quand elle change. -->
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>
        <receiver
            android:name=".widgets.OneColumnAgendaWidget"
            android:exported="false"
            android:label="@string/widget_agenda_one_column_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_one_column_info" />
        </receiver>
        <receiver
            android:name=".widgets.TwoColumnAgendaWidget"
            android:exported="false"
            android:label="@string/widget_agenda_two_columns_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_two_columns_info" />
        </receiver>
        <receiver
            android:name=".widgets.SystemWidget"
            android:exported="false"
            android:label="@string/widget_system_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_system_info" />
        </receiver>
        <receiver
            android:name=".widgets.AdvancedSystemWidget"
            android:exported="false"
            android:label="@string/widget_system_advanced_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_system_advanced_info" />
        </receiver>
        <receiver
            android:name=".widgets.WorldClockWidget"
            android:exported="false"
            android:label="@string/widget_world_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_world_clock_info" />
        </receiver>
        <receiver
            android:name=".widgets.CountdownWidget"
            android:exported="false"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <receiver
            android:name=".widgets.ControlsWidget"
            android:exported="false"
            android:label="@string/widget_controls_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_controls_info" />
        </receiver>
        <receiver
            android:name=".widgets.MonthWidget"
            android:exported="false"
            android:label="@string/widget_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>
        <receiver
            android:name=".widgets.WeatherWidget"
            android:exported="false"
            android:label="@string/widget_weather_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>
        <receiver
            android:name=".widgets.SunMoonWidget"
            android:exported="false"
            android:label="@string/widget_sun_moon_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sun_moon_info" />
        </receiver>
        <receiver
            android:name=".widgets.RainWidget"
            android:exported="false"
            android:label="@string/widget_rain_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rain_info" />
        </receiver>
        <receiver
            android:name=".widgets.AllergyWidget"
            android:exported="false"
            android:label="@string/widget_allergy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_allergy_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <receiver
            android:name=".widgets.BatteryWidget"
            android:exported="false"
            android:label="@string/widget_battery_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>
        <receiver
            android:name=".widgets.DeviceWidget"
            android:exported="false"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_device_info" />
        </receiver>
        <receiver
            android:name=".widgets.BluetoothDevicesWidget"
            android:exported="false"
            android:label="@string/widget_bt_devices_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.BATTERY_LEVEL_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bt_devices_info" />
        </receiver>
        <receiver
            android:name=".widgets.ScreenTimeWidget"
            android:exported="false"
            android:label="@string/widget_screen_time_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screen_time_info" />
        </receiver>
        <receiver
            android:name=".widgets.MobileDataWidget"
            android:exported="false"
            android:label="@string/widget_mobile_data_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mobile_data_info" />
        </receiver>
        <receiver
            android:name=".widgets.ForecastWidget"
            android:exported="false"
            android:label="@string/widget_forecast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_forecast_info" />
        </receiver>
        <receiver
            android:name=".widgets.AnalogClockWidget"
            android:exported="false"
            android:label="@string/widget_analog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_info" />
        </receiver>
        <receiver
            android:name=".widgets.EphemerisWidget"
            android:exported="false"
            android:label="@string/widget_ephemeris_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ephemeris_info" />
        </receiver>
        <receiver
            android:name=".widgets.TimerWidget"
            android:exported="false"
            android:label="@string/widget_timer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>
        <receiver
            android:name=".widgets.MediaWidget"
            android:exported="false"
            android:label="@string/widget_media_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_info" />
        </receiver>
        <!-- Lecture en cours : suit les sessions multimédias (aucune notification lue). -->
        <service
            android:name=".media.MediaListener"
            android:exported="true"
            android:label="@string/media_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Tuiles des réglages rapides. -->
        <service
            android:name=".tiles.WeatherTile"
            android:exported="true"
            android:icon="@drawable/icon_partly_cloudy"
            android:label="@string/tile_weather"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.WallpaperTile"
            android:exported="true"
            android:icon="@drawable/tile_wallpaper"
            android:label="@string/tile_wallpaper"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BatteryTile"
            android:exported="true"
            android:icon="@drawable/tile_battery"
            android:label="@string/tile_battery"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Écran de veille, pendant la charge ou sur un socle. -->
        <service
            android:name=".dream.HaloDream"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/halo_dream" />
        </service>
        <!-- Fond d'écran animé « Circuit ». -->
        <service
            android:name=".wallpaper.HaloWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/halo_wallpaper" />
        </service>
        <service
            android:name=".wallpaper.HorizonWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_horizon_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/halo_wallpaper_horizon" />
        </service>
        <service
            android:name=".wallpaper.SkyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_sky_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/halo_wallpaper_sky" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Contrôles : ouvrir l'appareil photo. -->
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Ouvrir un événement ou un jour dans l'application Agenda. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="content" android:host="com.android.calendar"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

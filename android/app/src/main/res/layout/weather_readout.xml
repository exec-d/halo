<?xml version="1.0" encoding="utf-8"?>
<!-- Un relevé du widget Météo : libellé, valeur. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/weather_readout_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.42"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:textAllCaps="true"
        android:textColor="@color/clock_line"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/weather_readout_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.58"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:textColor="@color/clock_core"
        android:textSize="14sp" />
</LinearLayout>

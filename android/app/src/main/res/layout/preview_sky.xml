<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_sky -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_sky_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/preview_sky_title"
            style="@style/HaloLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sky_title" />
        <TextView
            android:id="@+id/preview_sky_sunset"
            style="@style/HaloLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coucher 19:30" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/preview_sky_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/preview_sky_name_0"
                style="@style/HaloLabel"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Saturne" />
            <TextView
                android:id="@+id/preview_sky_where_0"
                style="@style/HaloConsole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Se lève à l\'est" />
            <TextView
                android:id="@+id/preview_sky_time_0"
                style="@style/HaloConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="20:30" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/preview_sky_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/preview_sky_name_1"
                style="@style/HaloLabel"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Lune" />
            <TextView
                android:id="@+id/preview_sky_where_1"
                style="@style/HaloConsole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Se lève au nord-est" />
            <TextView
                android:id="@+id/preview_sky_time_1"
                style="@style/HaloConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="21:50" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/preview_sky_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/preview_sky_name_2"
                style="@style/HaloLabel"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Vénus" />
            <TextView
                android:id="@+id/preview_sky_where_2"
                style="@style/HaloConsole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ouest, basse" />
            <TextView
                android:id="@+id/preview_sky_time_2"
                style="@style/HaloConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="→ 20:15" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_sky -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_sky_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/preview_sky_moon"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:maxHeight="84dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/clock_core"
            android:src="@drawable/moon_5" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    style="@style/HaloLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/moon_title" />
                <TextView
                    android:id="@+id/preview_sky_age"
                    style="@style/HaloLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
            android:text="19 j · 81 %" />
            </LinearLayout>
            <TextView
                android:id="@+id/preview_sky_phase"
                style="@style/HaloValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
            android:text="Gibbeuse décroissante" />
            <TextView
                android:id="@+id/preview_sky_countdown"
                style="@style/HaloDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
            android:text="Pleine lune dans 26 jours" />
            <TextView
                android:id="@+id/preview_sky_times"
                style="@style/HaloConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
            android:text="Lever 20:57 · coucher demain 13:39" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/preview_sky_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/preview_next_icon_0"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/clock_core" android:src="@drawable/moon_6" />
            <TextView
                android:id="@+id/preview_next_name_0"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="10sp" android:text="Dern. quartier" />
            <TextView
                android:id="@+id/preview_next_date_0"
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textSize="9sp" android:text="sam. 3 oct." />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/preview_next_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/clock_core" android:src="@drawable/moon_0" />
            <TextView
                android:id="@+id/preview_next_name_1"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="10sp" android:text="Nouvelle" />
            <TextView
                android:id="@+id/preview_next_date_1"
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textSize="9sp" android:text="sam. 10 oct." />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/preview_next_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/clock_core" android:src="@drawable/moon_2" />
            <TextView
                android:id="@+id/preview_next_name_2"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="10sp" android:text="1er quartier" />
            <TextView
                android:id="@+id/preview_next_date_2"
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textSize="9sp" android:text="dim. 18 oct." />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/preview_next_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/clock_core" android:src="@drawable/moon_4" />
            <TextView
                android:id="@+id/preview_next_name_3"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textSize="10sp" android:text="Pleine" />
            <TextView
                android:id="@+id/preview_next_date_3"
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textSize="9sp" android:text="lun. 26 oct." />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

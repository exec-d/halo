<?xml version="1.0" encoding="utf-8"?>
<!-- Horloge et agenda : l'horloge en tête de la première colonne, puis les
     événements, qui continuent dans la seconde. Le bloc horloge reprend
     widget_clock_compact (mêmes identifiants, remplis par ClockViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/agenda_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/clock_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clock_agenda_time_height"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/wux_dots"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                android:textColor="@color/clock_core" />

            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:format12Hour="@string/clock_date_format"
                android:format24Hour="@string/clock_date_format"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:textAllCaps="true"
                android:textColor="@color/clock_core"
                android:textSize="14sp" />

            <!-- Prochaine alarme, masquée quand il n'y en a pas. -->
            <LinearLayout
                android:id="@+id/clock_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alarm"
                    android:tint="@color/clock_core" />

                <TextView
                    android:id="@+id/clock_alarm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="@color/clock_glow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="14"
                    android:textAllCaps="true"
                    android:textColor="@color/clock_core"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/clock_divider_horizontal"
                android:tint="@color/clock_line" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_col1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <ImageView
        android:id="@+id/agenda_separator"
        android:layout_width="12dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/agenda_divider_dotted"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:id="@+id/agenda_col2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical" />

    <ImageView
        android:id="@+id/agenda_bars"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/agenda_bars"
        android:tint="@color/clock_line" />
</LinearLayout>

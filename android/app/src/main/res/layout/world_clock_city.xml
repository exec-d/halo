<?xml version="1.0" encoding="utf-8"?>
<!-- Une ville : son nom, son heure et son jour, à son fuseau. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/world_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:textAllCaps="true"
        android:textColor="@color/clock_line"
        android:textSize="11sp" />

    <TextClock
        android:id="@+id/world_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="30sp" />

    <TextClock
        android:id="@+id/world_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:format12Hour="EEE d"
        android:format24Hour="EEE d"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        android:textAllCaps="true"
        android:textColor="@color/clock_line"
        android:textSize="10sp" />
</LinearLayout>

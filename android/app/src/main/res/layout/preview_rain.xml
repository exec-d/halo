<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu dans la liste des widgets du lanceur, valeurs d'exemple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:src="@drawable/icon_rain"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:text="Pluie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="Pluie probable à 19h (70 %)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="18sp" />
            <TextView
                android:text="Cumul 12 h 2,4 mm · max 80 %"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/sample_rain_chart"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:text="15h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="21h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="02h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>

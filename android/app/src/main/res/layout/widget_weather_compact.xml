<?xml version="1.0" encoding="utf-8"?>
<!-- Météo sur une rangée : température, état, min/max et pluie. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding">

    <TextView
        android:id="@+id/weather_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="34sp" />

    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/weather_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_core"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/weather_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/weather_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

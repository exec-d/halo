<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_mobile_data -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_md_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/HaloLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mobile_data_title" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">
                <TextView android:id="@+id/preview_md_used"
    android:text="8,1 Go" style="@style/HaloValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="30sp" />
                <TextView android:id="@+id/preview_md_quota"
    android:text="/ 50 Go" style="@style/HaloDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/clock_core" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/preview_md_detail"
    android:text="Aujourd\'hui 440 Mo · reprise dans 12 j" style="@style/HaloDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/preview_md_readouts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView style="@style/HaloLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mobile_data_projection" />
            <TextView android:id="@+id/preview_md_projection"
    android:text="≈ 13,6 Go" style="@style/HaloValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="15sp" />
            <TextView style="@style/HaloLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/mobile_data_average" />
            <TextView android:id="@+id/preview_md_average"
    android:text="452 Mo" style="@style/HaloValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/preview_md_chart"
    android:src="@drawable/sample_data_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/clock_line" />

    <TextView
        android:id="@+id/preview_md_empty"
        style="@style/HaloDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:textColor="@color/clock_core"
        android:visibility="gone" />
</LinearLayout>

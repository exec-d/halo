<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_network -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_network_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/preview_network_kind"
                style="@style/HaloLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi · 5 GHz" />
            <TextView
                android:id="@+id/preview_network_name"
                style="@style/HaloValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="22sp"
                android:text="Livebox-4F2A" />
            <TextView
                android:id="@+id/preview_network_detail"
                style="@style/HaloDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="−58 dBm · ping 18 ms · 192.168.1.24" />
        </LinearLayout>
        <ImageView
            android:id="@+id/preview_network_bars"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/clock_line" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_network_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_down" />
            <TextView
                android:id="@+id/preview_network_down"
                style="@style/HaloValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="312 Mb/s" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/HaloLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_up" />
            <TextView
                android:id="@+id/preview_network_up"
                style="@style/HaloValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="48 Mb/s" />
        </LinearLayout>
        <TextView
            android:id="@+id/preview_network_test"
            style="@style/HaloLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_outline"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="12dp"
            android:text="@string/net_test" />
    </LinearLayout>
    <TextView
        android:id="@+id/preview_network_tested"
        style="@style/HaloDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Testé il y a 2 heures" />
</LinearLayout>

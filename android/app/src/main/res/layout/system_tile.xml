<?xml version="1.0" encoding="utf-8"?>
<!-- Une case des widgets système, ajoutée dans une rangée par SystemWidgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/system_tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <TextView
        android:id="@+id/system_tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:textColor="@color/clock_line"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/system_tile_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/system_tile_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:textAllCaps="true"
        android:textColor="@color/clock_line"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/system_tile_gauge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressBackgroundTint="@color/clock_glow"
        android:progressTint="@color/clock_line" />
</LinearLayout>

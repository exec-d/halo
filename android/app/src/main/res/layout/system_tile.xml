<?xml version="1.0" encoding="utf-8"?>
<!-- Une case des widgets système, ajoutée dans une rangée par SystemWidgets.
     Étiquette et valeur rétrécissent pour tenir en entier plutôt que d'être
     coupées. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/system_tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <TextView
        android:id="@+id/system_tile_label"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="0.5sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:textColor="@color/clock_line"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/system_tile_value"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/system_tile_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/text_shade"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"
        android:textColor="@color/clock_line"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/system_tile_gauge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressBackgroundTint="@color/clock_glow"
        android:progressTint="@color/clock_line" />
</LinearLayout>

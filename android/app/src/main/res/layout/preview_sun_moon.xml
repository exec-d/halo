<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu dans la liste des widgets du lanceur, valeurs d'exemple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:src="@drawable/icon_sunrise"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">
            <TextView
                android:text="Lever"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="07:42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="18sp" />
            <TextView
                android:text=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:src="@drawable/icon_moon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">
            <TextView
                android:text="Coucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="19:48"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="18sp" />
            <TextView
                android:text="Jour 12 h 06"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:src="@drawable/moon_3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">
            <TextView
                android:text="Lune"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="Gibbeuse croissante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="18sp" />
            <TextView
                android:text="Éclairée à 78 %"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/text_shade"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Une heure de prévision : heure, icône, température. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        android:id="@+id/weather_hour_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        android:textAllCaps="true"
        android:textColor="@color/clock_line"
        android:textSize="10sp" />
    <ImageView
        android:id="@+id/weather_hour_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:tint="@color/clock_line" />
    <TextView
        android:id="@+id/weather_hour_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="15sp" />
</LinearLayout>

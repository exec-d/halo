<?xml version="1.0" encoding="utf-8"?>
<!-- Widget système 4x1 : trois cases (batterie, réseau, stockage) séparées
     par des traits lumineux, dans le style de l'horloge. Chaque case est
     remplie par SystemWidgetProvider et ouvre le réglage correspondant. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/system_battery"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/system_battery_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/system_battery_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:textColor="@color/clock_core"
            android:textFontWeight="800"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/system_battery_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/system_battery_gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/clock_glow"
            android:progressTint="@color/clock_line" />
    </LinearLayout>

    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:id="@+id/system_network"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/system_network_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/system_network_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:textColor="@color/clock_core"
            android:textFontWeight="800"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/system_network_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/system_network_gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/clock_glow"
            android:progressTint="@color/clock_line" />
    </LinearLayout>

    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:id="@+id/system_storage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/system_storage_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/system_storage_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:textColor="@color/clock_core"
            android:textFontWeight="800"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/system_storage_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/system_storage_gauge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/clock_glow"
            android:progressTint="@color/clock_line" />
    </LinearLayout>
</LinearLayout>

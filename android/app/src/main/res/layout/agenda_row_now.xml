<?xml version="1.0" encoding="utf-8"?>
<!-- Un événement en cours : comme agenda_row, sans estompage, titre en gras
     et détail plus clair. Hauteur prévue : AgendaRenderer.ROW. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="3dp">

    <ImageView
        android:id="@+id/agenda_row_bar"
        android:layout_width="13dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/agenda_event_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/agenda_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
        android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textColor="@color/clock_core"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/text_shade"
        android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="7"
            android:textColor="@color/clock_core"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

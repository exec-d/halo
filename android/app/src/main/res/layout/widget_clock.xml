<?xml version="1.0" encoding="utf-8"?>
<!-- Motifs d'heure et de date repris dans MainActivity pour l'aperçu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="64sp" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="@string/clock_date_format"
        android:format24Hour="@string/clock_date_format"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/clock_accent"
        android:textSize="18sp" />

    <!-- Prochaine alarme, masquée quand il n'y en a pas. -->
    <LinearLayout
        android:id="@+id/clock_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alarm"
            android:tint="@color/clock_accent" />

        <TextView
            android:id="@+id/clock_alarm_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/clock_accent"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>

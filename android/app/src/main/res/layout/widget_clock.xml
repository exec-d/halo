<?xml version="1.0" encoding="utf-8"?>
<!-- Motifs d'heure et de date repris dans MainActivity pour l'aperçu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFFFF"
        android:textSize="64sp" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="@string/clock_date_format"
        android:format24Hour="@string/clock_date_format"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/clock_accent"
        android:textSize="18sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_media -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/preview_media_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/preview_media_art"
    android:src="@drawable/sample_glyph_headphones"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/clock_line" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/preview_media_app"
    android:text="Musique" style="@style/HaloLabel" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/preview_media_title"
    android:text="Midnight City" style="@style/HaloValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="16sp" />
            <TextView android:id="@+id/preview_media_artist"
    android:text="M83" style="@style/HaloDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
            <ProgressBar
                android:id="@+id/preview_media_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progress="420"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView android:id="@+id/preview_media_previous" android:layout_width="36dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:contentDescription="@string/media_previous" android:padding="8dp" android:src="@drawable/media_previous" android:tint="@color/clock_line" />
        <ImageView android:id="@+id/preview_media_play"
    android:src="@drawable/timer_pause" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/media_play" android:padding="7dp" android:tint="@color/clock_core" />
        <ImageView android:id="@+id/preview_media_next" android:layout_width="36dp" android:layout_height="40dp" android:contentDescription="@string/media_next" android:padding="8dp" android:src="@drawable/media_next" android:tint="@color/clock_line" />
    </LinearLayout>

    <TextView
        android:id="@+id/preview_media_empty"
        style="@style/HaloDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/clock_core"
        android:visibility="gone" />
</FrameLayout>

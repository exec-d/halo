<?xml version="1.0" encoding="utf-8"?>
<!-- Horloge sur une rangée : date sur une ligne. Même identifiants dans les deux mises en page, pour que
     ClockWidgetProvider les remplisse de la même façon. Le halo des textes est
     leur ombre, sans décalage ; celui des traits est dessiné dans les images
     (tool/clock_assets.py) et teinté ici. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="2dp">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/clock_glow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="24"
        android:textColor="@color/clock_core"
        android:textFontWeight="800"
        android:textSize="44sp" />

    <ImageView
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_vertical"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="@string/clock_date_format"
            android:format24Hour="@string/clock_date_format"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"
            android:textAllCaps="true"
            android:textColor="@color/clock_core"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_horizontal"
            android:tint="@color/clock_line" />

        <!-- Prochaine alarme, masquée quand il n'y en a pas. -->
        <LinearLayout
            android:id="@+id/clock_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- L'image porte son halo : sa marge transparente sert d'espacement. -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="-4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/clock_alarm"
                android:tint="@color/clock_core" />

            <TextView
                android:id="@+id/clock_alarm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:textAllCaps="true"
                android:textColor="@color/clock_core"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

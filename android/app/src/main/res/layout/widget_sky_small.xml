<?xml version="1.0" encoding="utf-8"?>
<!-- Lune en petit (2 × 2) : la Lune, sa phase, la part éclairée (SkyWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sky_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <ImageView
        android:id="@+id/sky_moon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/clock_core" />
    <TextView
        android:id="@+id/sky_phase"
        style="@style/HaloValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/sky_age"
        style="@style/HaloLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
</LinearLayout>

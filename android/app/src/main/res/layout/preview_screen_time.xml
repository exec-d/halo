<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du lanceur, données d'exemple : widget_screen_time -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/preview_st_dial"
    android:src="@drawable/sample_screen_dial"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/clock_line" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/preview_st_total"
    android:text="3 h 12" style="@style/HaloValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/preview_st_unlocks"
    android:text="42 déverr." style="@style/HaloDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView style="@style/HaloLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/screen_time_title" />
        <LinearLayout
            android:id="@+id/preview_st_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/HaloDetail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chrome" android:textColor="@color/clock_core" />
                    <TextView style="@style/HaloDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 h 12" />
                </LinearLayout>
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:max="100" android:progress="100" android:progressBackgroundTint="@color/clock_glow" android:progressTint="@color/clock_line" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/HaloDetail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Messages" android:textColor="@color/clock_core" />
                    <TextView style="@style/HaloDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="41 min" />
                </LinearLayout>
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:max="100" android:progress="57" android:progressBackgroundTint="@color/clock_glow" android:progressTint="@color/clock_line" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView style="@style/HaloDetail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maps" android:textColor="@color/clock_core" />
                    <TextView style="@style/HaloDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23 min" />
                </LinearLayout>
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:max="100" android:progress="32" android:progressBackgroundTint="@color/clock_glow" android:progressTint="@color/clock_line" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/preview_st_empty"
            style="@style/HaloDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:textColor="@color/clock_core"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

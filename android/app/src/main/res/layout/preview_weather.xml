<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu dans la liste des widgets du lanceur, valeurs d'exemple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.42"
            android:orientation="vertical">
            <TextView
                android:text="Maintenant · Lyon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="18°"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="48sp" />
            <TextView
                android:text="Peu nuageux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <ImageView
                    android:src="@drawable/sample_weather_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:tint="@color/clock_core" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:text="11°"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/clock_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10"
                        android:textColor="@color/clock_line"
                        android:textSize="9sp" />
                    <TextView
                        android:text="26°"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/clock_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10"
                        android:textColor="@color/clock_line"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:text="Ressenti"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="17°"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:text="Vent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="12 km/h ↗ SO"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:text="Humidité"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="72 %"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:text="UV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="4 · Modéré"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:text="Pluie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.42"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />
            <TextView
                android:text="Pluie probable à 16h (60 %)"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.58"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_core"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/sample_weather_curve"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:tint="@color/clock_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <TextView
            android:text="22h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="04h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="10h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="16h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        <TextView
            android:text="21h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu dans la liste des widgets du lanceur, valeurs d'exemple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/agenda_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/icon_flashlight_off"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <TextView
            android:text="Lampe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/icon_wifi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <TextView
            android:text="Wi-Fi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/icon_bluetooth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <TextView
            android:text="Bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/icon_volume"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <TextView
            android:text="Son"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:src="@drawable/icon_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:tint="@color/clock_line" />

        <TextView
            android:text="Photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="@color/clock_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textAllCaps="true"
            android:textColor="@color/clock_line"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>

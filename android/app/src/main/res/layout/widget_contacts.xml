<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts favoris : jusqu'à six pastilles, un toucher pour appeler ou écrire (ContactsWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contacts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <TextView
        android:id="@+id/contacts_title"
        style="@style/HaloLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contacts_title" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/contacts_slot_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_0"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_0"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contacts_slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_1"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contacts_slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_2"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contacts_slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_3"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contacts_slot_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_4"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contacts_slot_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/contacts_photo_5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/contacts_name_5"
                style="@style/HaloDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/clock_core" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/contacts_empty"
        style="@style/HaloDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/contacts_empty"
        android:visibility="gone" />
</LinearLayout>

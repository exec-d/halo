<?xml version="1.0" encoding="utf-8"?>
<!-- Un appareil Bluetooth : silhouette, pile de cellules, niveau et nom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bt_device"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/bt_glyph"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:tint="@color/clock_core" />
    <ImageView
        android:id="@+id/bt_cells"
        android:layout_width="11dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:tint="@color/clock_line" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/bt_level" style="@style/HaloValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/bt_name" style="@style/HaloDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu dans la liste des widgets du lanceur (android:previewLayout),
     avec des valeurs d'exemple. Même structure que widget_system_advanced et system_tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/agenda_padding"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="SIGNAL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="Orange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text="SIGNAL 3/4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:progress="75"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />
        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="WI-FI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="Connecté"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text="5 GHZ · 866 MB/S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:progress="100"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />
        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="BLUETOOTH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="Activé"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text=""
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:visibility="invisible"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />
        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="BATTERIE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="82 %"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text="EN CHARGE · 31 °C"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:progress="82"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        android:src="@drawable/clock_divider_horizontal"
        android:tint="@color/clock_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="MÉMOIRE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="3,1 Go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text="LIBRES SUR 8 GO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:progress="61"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />
        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="STOCKAGE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="64 Go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text="LIBRES SUR 128 GO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:progress="50"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/clock_glow"
                android:progressTint="@color/clock_line" />
        </LinearLayout>
        <ImageView
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/clock_divider_vertical"
            android:tint="@color/clock_line" />
        <LinearLayout
                android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:text="LOCALISATION"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <TextView
                android:text="Activé"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:textColor="@color/clock_core"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:text=""
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/clock_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/clock_line"
                android:textSize="10sp" />

            <ProgressBar
                android:visibility="invisible"

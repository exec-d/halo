<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_weather_description"
    android:previewLayout="@layout/preview_weather"
    android:initialLayout="@layout/widget_weather"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:configure="dev.levilainpetit.wux.WidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:widgetCategory="home_screen" />

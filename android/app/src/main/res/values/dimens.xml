<?xml version="1.0" encoding="utf-8"?>
<!-- Marge des widgets. Le lanceur des Pixel récents arrondit fortement les
     coins, et d'autant plus que le widget est petit (jusqu'à ~50 dp sur un
     widget de deux rangées, mesuré sur des captures). À 8 dp du haut ou du
     bas, une lettre doit être à 24 dp du bord pour rester hors de l'arrondi.
     Relue par AgendaRenderer pour savoir combien de lignes tiennent ; les
     dessins des widgets comptent 2 × 24 dp en largeur et 2 × 8 dp en hauteur. -->
<resources>
    <dimen name="agenda_padding">24dp</dimen>
    <!-- Marge haute et basse des widgets de plus d'une rangée. -->
    <dimen name="widget_padding_vertical">8dp</dimen>
</resources>
